# ========================================
# Cấu hình API cho Landing Page
# Đổi tên file này thành .env.local và điền các thông số thật
# ========================================

# 1. Google Sheets Webhook
# URL tạo từ Google Apps Script để lưu form lead
# Hướng dẫn tạo: Xem file docs/google-sheets-script.js
NEXT_PUBLIC_GOOGLE_SHEETS_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# 2. Upstash Redis
# Dùng để lưu trữ số lượt xem và lượt yêu thích thực tế (Real-time & Cross-device)
# Đăng ký miễn phí tại: https://upstash.com/
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"
